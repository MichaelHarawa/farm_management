    "expo-file-system": "57.0.7",
    "expo-linking": "57.0.11",
    "expo-local-authentication": "57.0.3",
    "expo-network": "57.0.2",
    "expo-router": "57.0.24",
    "expo-secure-store": "57.0.4",
    "expo-sqlite": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.81.0",
